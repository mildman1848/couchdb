#!/usr/bin/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

file_env() {
  local var="$1"
  local def="${2:-}"
  local file_var="FILE__${var}"
  local val="$def"
  if [[ -n "${!var:-}" ]]; then
    # LSIO env-init may already expand FILE__VAR into VAR before this helper runs.
    # Prefer the already-populated variable and drop the file pointer.
    val="${!var}"
  elif [[ -n "${!file_var:-}" ]]; then
    val="$(< "${!file_var}")"
  fi
  export "${var}"="${val}"
  unset "${file_var}"
}
